mount -o rw,remount / 2>/dev/null
mount -o rw,remount / / 2>/dev/null
mount -o rw,remount rootfs 2>/dev/null
mount -o rw,remount /system 2>/dev/null
mount -o rw,remount /system /system 2>/dev/null
busybox mount -o rw,remount / 2>/dev/null
busybox mount -o rw,remount / / 2>/dev/null
busybox mount -o rw,remount rootfs 2>/dev/null
busybox mount -o rw,remount /system 2>/dev/null
busybox mount -o rw,remount /system /system 2>/dev/null

LS=/system/etc/H_SPEED/LOGS/HS_IO.log

busybox rm -f $LS
busybox touch $LS

busybox echo "# H Speed log" | busybox tee -a $LS
busybox echo "" | busybox tee -a $LS
busybox echo "$( date +"%m-%d-%Y %H:%M:%S" ) Enabling I/O Scheduler Noop.." | busybox tee -a $LS

echo "noop" > /sys/block/mmcblk0/queue/scheduler
echo "noop" > /sys/block/mmcblk0boot0/queue/scheduler
echo "noop" > /sys/block/mmcblk0boot1/queue/scheduler
echo "noop" > /sys/block/mmcblk0rpmb/queue/scheduler
echo "noop" > /sys/block/mmcblk1/queue/scheduler

busybox echo "" | busybox tee -a $LS
busybox echo "$( date +"%m-%d-%Y %H:%M:%S" ) I/O Scheduler Noop is enabled" | busybox tee -a $LS
